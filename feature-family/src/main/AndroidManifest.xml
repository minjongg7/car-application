<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pleos TextToSpeech SDK (ON_DEVICE): 차량 Speech Service 로 음성 합성. normal 권한(선언만 하면 허용).
         Pleos 사전 승인 범위인지 제출 전에 확인할 것. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- Pleos SpeechToText SDK: 음성 놀이·휴식 질문의 대답 인식. 문서상 이 권한 하나로 initialize/request/stop 등 모든 API 사용
         (마이크는 Pleos Speech Service 가 제어 → RECORD_AUDIO 선언 안 함). Pleos 사전 승인 범위인지 제출 전에 확인할 것. -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <application>
        <!-- 추가 화면 ③ Family Care: 나이별 동승자 콘텐츠. 메인 앱 안의 화면 (왼쪽 레일에서 진입, 별도 런처 아이콘 없음). -->
        <activity
            android:name="com.hmgapps.family.ui.FamilyCareActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="Family Care" />
    </application>
</manifest>
